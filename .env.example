# URL pública sem barra no final. Cadastre o mesmo valor no hPanel.
NEXT_PUBLIC_APP_URL=https://app.seudominio.com.br

# Nome exibido pela aplicação. Variáveis NEXT_PUBLIC_* ficam visíveis no navegador.
NEXT_PUBLIC_APP_NAME=Minha Aplicação

# Exemplo de segredo exclusivo do servidor. Nunca use NEXT_PUBLIC_ em segredos.
APP_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
